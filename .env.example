# Environment Variables for MSME Underwriting Copilot

# Postgres Database & pgvector
POSTGRES_DB=underwriting_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/underwriting_db

# Core Service (Spring Boot 3)
CORE_SERVICE_PORT=8080
CORE_SERVICE_URL=http://core-service:8080
JWT_SECRET=super_secret_jwt_key_with_at_least_256_bits_length_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# AI Service (FastAPI + LangGraph)
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000

# LLM & Embedding Providers (Swappable)
# Supported Providers: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# API Keys (Set required key for chosen provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://langfuse:3000

# Policy & Extraction Configuration
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
RETRIEVAL_MODE=hybrid_rrf
CHUNKING_STRATEGY=heading_aware
